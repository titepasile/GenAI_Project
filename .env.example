# Vorlage für die Datei .env
# 1. Diese Datei kopieren und die Kopie ".env" nennen
# 2. Platzhalter durch echte Werte ersetzen
# 3. Keine Anführungszeichen, keine Leerzeichen um das "="
# WICHTIG: Die Datei ".env" niemals mit Git hochladen!

# --- Modell (Pflicht): ---
LLM_API_KEY=dein-key-hier #Auskommentieren wenn LITELLM_API_KEY und LANGSMITH_API_KEY verwendet werden
LLM_MODEL=dein-modell-hier
LLM_BASE_URL=dein-base-url-hier

# Alternativen (jeweils passenden LLM_API_KEY eintragen):
#   Mistral : LLM_BASE_URL=https://api.mistral.ai/v1                                   LLM_MODEL=mistral-small-latest
#   Gemini  : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/    LLM_MODEL=gemini-2.5-flash
#   Kurs    : LLM_BASE_URL=https://litellm.engines.aisl.science/v1                     LLM_MODEL=gpt-5.6-luna

# --- LangSmith (Tracing) ---
# Schlüssel erzeugen auf smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=dein-langsmith-key-hier
